# Repo-root ignores only.
# Each surface keeps its own .gitignore for build artifacts (e.g. app/.gitignore
# ignores Flutter's build/ and .dart_tool/).

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# Local environment and credential files. Keep sanitized templates tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
service-account*.json
service_account*.json
client_secret*.json
